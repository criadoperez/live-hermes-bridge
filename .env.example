# Copy to .env and fill in. Never commit .env.
# OpenAI project key with GPT-Live access (paid tier; free tier has no Live).
OPENAI_API_KEY=
# Bearer for a Hermes agent API (API_SERVER_KEY in that agent's .env).
# With several backends, add one variable per backend and point each
# backends.yaml entry at its own via key_env, e.g. HERMES_API_KEY_TWO.
HERMES_API_KEY=
# Bridge bind address and port. Localhost only by default.
LHB_HOST=127.0.0.1
LHB_PORT=8000
# Path to the backends file.
LHB_BACKENDS=backends.yaml
